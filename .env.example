# Server-side only. Required for a live Jev call.
# The default test suite must pass without this value.
TYPESAFE_API_KEY=

# Optional pinned model id from the TypeSafe models page.
# When empty, the SDK default is used and the concrete id is stored on the decision.
JEV_MODEL=

PORT=3000
# Inside Docker this must be 0.0.0.0. Locally, 127.0.0.1 is enough.
HOST=127.0.0.1
LOG_LEVEL=info
